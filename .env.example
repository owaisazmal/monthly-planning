# Copy to `.env` and fill in. `.env` is gitignored; this file is the only one
# that gets committed, and it must never hold real values.
#
# These two are the *public* half of the backend: they ship inside the app
# binary and are gated by row-level security (see supabase/migrations). They
# are kept out of the repo as a matter of hygiene, not because a leak would
# grant anything. The service_role key has no line here on purpose — it never
# belongs in the app, this file, or any EXPO_PUBLIC_ variable.
#
# For EAS builds, set the same two names as EAS environment variables
# (`eas env:create`) rather than in eas.json, which is committed.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
